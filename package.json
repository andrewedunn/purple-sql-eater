{
  "name": "purple-sql-eater",
  "productName": "Purple SQL Eater",
  "version": "0.2.3",
  "description": "A simple, fast SQL client for business analysts",
  "main": "dist/main/main/main.js",
  "author": {
    "name": "Andrew Dunn",
    "email": "andrew@andrewedunn.com"
  },
  "homepage": "https://github.com/andrewedunn/purple-sql-eater",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewedunn/purple-sql-eater.git"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:renderer": "vitest run --config vitest.config.renderer.ts",
    "test:renderer:watch": "vitest --config vitest.config.renderer.ts",
    "test:all": "npm run test && npm run test:renderer",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.config.renderer.ts --coverage"
  },
  "keywords": [
    "sql",
    "database",
    "bigquery",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.3.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.13.13",
    "chokidar": "^3.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql-formatter": "^15.6.12",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  }
}
